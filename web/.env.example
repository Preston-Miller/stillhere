# Copy to .env.local for dev; set the same keys in Vercel → Project → Settings → Environment Variables.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production (Vercel): https://www.stillhereoffline.com

# Stripe (use sk_test_ / test price while building)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Cloudflare R2: the private releases bucket + an API token with Object Read only (uploads use scripts/r2.env)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=stillhere-releases
R2_OBJECT_KEY=releases/Stillhere-0.1.0.dmg

# Waitlist storage: Neon Postgres via Vercel Marketplace (sets DATABASE_URL automatically).
# Local dev: `vercel env pull .env.local`. Create tables: `node --env-file=.env.local scripts/migrate.mjs`.
DATABASE_URL=

# Password for /api/admin (signup counts + CSV export). Any username works.
ADMIN_PASSWORD=
