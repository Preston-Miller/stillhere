# Copy to .env.local for dev; set the same keys in Vercel → Project → Settings → Environment Variables.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production (Vercel): https://www.stillhereoffline.com

# Stripe (use sk_test_ / test price while building)
STRIPE_SECRET_KEY=
# Publishable key (pk_test_… locally, pk_live_… on Vercel). Without it /checkout falls back to the Stripe-hosted page.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Cloudflare R2: the private releases bucket + an API token with Object Read only (uploads use scripts/r2.env)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=stillhere-releases
R2_OBJECT_KEY=releases/Stillhere-0.1.0.dmg

# Waitlist storage: Neon Postgres via Vercel Marketplace (sets DATABASE_URL automatically).
# Local dev: `vercel env pull .env.local`. Create tables: `node --env-file=.env.local scripts/migrate.mjs`.
DATABASE_URL=

# Password for /api/admin (signup counts + CSV export). Any username works.
ADMIN_PASSWORD=

# Download-link email (lib/email.ts), sent through Resend. The sending domain must be verified in Resend.
RESEND_API_KEY=
EMAIL_FROM="stillhere <download@stillhereoffline.com>"

# Ad tracking (all optional; each platform stays off until its values are set). See app/ad-tags.tsx and lib/ads.ts.
# Meta: Events Manager → your Pixel. The token is from Settings → Conversions API → Generate access token.
NEXT_PUBLIC_META_PIXEL_ID=
META_CAPI_TOKEN=
# Set while testing to see events under Test events without counting them; remove for launch.
META_TEST_EVENT_CODE=
# Google Ads: Goals → Conversions → a "Purchase" website conversion → "Use Google tag" gives AW-… and its label.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=
