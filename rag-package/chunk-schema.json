{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OffGrid authored reference unit",
  "type": "object",
  "required": [
    "schema_version",
    "chunk_id",
    "document_id",
    "section",
    "text",
    "source_ids",
    "review_status",
    "action_eligible",
    "content_completeness",
    "content_sha256",
    "checked_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "chunk_id": {
      "type": "string",
      "minLength": 1
    },
    "document_id": {
      "type": "string"
    },
    "section": {
      "type": "string"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "review_status": {
      "enum": [
        "medical_review_required",
        "editorially_checked",
        "incomplete_or_overview"
      ]
    },
    "action_eligible": {
      "type": "boolean"
    },
    "content_completeness": {
      "enum": [
        "bounded_procedure",
        "partial",
        "bounded_reference"
      ]
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "checked_at": {
      "type": "string",
      "format": "date"
    }
  }
}